#!/bin/sh
# On removal (not upgrade): stop the server for the pi user and switch it off at boot.
set -e
if [ "$1" = remove ] && id pi >/dev/null 2>&1 && [ -S /run/user/$(id -u pi)/bus ]; then
  su pi -s /bin/sh -c "XDG_RUNTIME_DIR=/run/user/$(id -u pi) systemctl --user disable --now nomad-ai-bridge.service" >/dev/null 2>&1 || true
fi
exit 0
