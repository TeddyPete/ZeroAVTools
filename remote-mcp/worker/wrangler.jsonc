{
  // Deploy with:  npx wrangler deploy   (after putting your VPC Service id below)
  "name": "cp0",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vpc_services": [
    { "binding": "DEVICE", "service_id": "REPLACE_WITH_VPC_SERVICE_ID", "remote": true }
  ]
}
