#!/bin/sh
# APPLaunch entry point for TNT MCP Link (also /usr/bin/tnt-mcp-link for SSH use,
# e.g. tnt-mcp-link --status; /usr/bin/tnt-remote is the old name).
# APPLaunch runs Exec without a shell, so the
# environment is set up here.
APP_DIR=/usr/share/APPLaunch/lib/tnt-mcp-link
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYGAME_HIDE_SUPPORT_PROMPT=1 SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy
export PATH="${PATH:-/usr/bin:/bin}:/usr/sbin:/sbin"
[ -z "$XDG_RUNTIME_DIR" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
cd "$APP_DIR" || exit 1
exec python3 -m tntremote "$@"
